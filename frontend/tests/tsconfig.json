{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020"],
    "outDir": "../.verify-build",
    "rootDir": "..",
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../src/domain/**/*.ts"]
}
